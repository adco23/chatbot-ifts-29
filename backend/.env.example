# Copiar a .env para desarrollo local. El archivo .env nunca se versiona.
# En Vercel estas variables se cargan desde la configuración del proyecto.

# Entorno de ejecución: local o produccion.
# En produccion no se lee ningún archivo .env.
ENTORNO=local

# Versión de la aplicación que informa GET /health.
VERSION_APP=0.1.0

# --- Modelos de lenguaje ---
# Ninguna de estas variables es obligatoria: la aplicación arranca sin ellas.
# Un proveedor sin clave queda fuera de la lista de proveedores disponibles.

# Clave de la API de Gemini (proveedor principal). Se genera en Google AI Studio,
# con una cuenta de Google y sin tarjeta. Vacía: Gemini no se usa.
GEMINI_API_KEY=

# Clave de la API de Groq (proveedor de respaldo). Se genera en la consola de
# GroqCloud, en la sección de claves de API, con el plan gratuito. Vacía: Groq no se usa.
GROQ_API_KEY=

# Modelo de cada proveedor. Debe estar disponible en su plan gratuito (RNF10).
# Si faltan, se usan estos mismos valores por defecto.
GEMINI_MODELO=gemini-3.8-flash
GROQ_MODELO=openai/gpt-oss-120b

# Tiempo máximo de espera de cada proveedor, en segundos (mayor que 0).
# Si faltan, se usan estos mismos valores por defecto.
GEMINI_TIMEOUT_SEGUNDOS=6
GROQ_TIMEOUT_SEGUNDOS=3

# Presupuesto total de una generación, en segundos, sumando todos los intentos.
# Cuando se agota, no se prueba con más proveedores. No puede ser menor que el
# mayor de los tiempos máximos por proveedor. Si falta, vale 9.
LLM_PRESUPUESTO_SEGUNDOS=9

# Orden de prioridad de los proveedores, separados por comas.
# Nombres válidos: gemini, groq. Un nombre desconocido impide arrancar.
# Si falta, vale gemini,groq.
LLM_ORDEN_PROVEEDORES=gemini,groq

# --- Embeddings ---
# Ninguna de estas variables es obligatoria: la aplicación arranca sin ellas.
# Hay un índice por proveedor: los vectores de uno no sirven para buscar en el otro.

# Proveedor de embeddings que se intenta primero: gemini o cloudflare. El otro queda
# de respaldo. Un nombre desconocido impide arrancar. Si falta, vale gemini.
EMBEDDING_PRIMARY=gemini

# Gemini usa para los embeddings la misma clave que para el modelo de lenguaje
# (GEMINI_API_KEY, más arriba). Sin esa clave, Gemini tampoco genera embeddings.
# Modelo y cantidad de dimensiones de sus vectores. Si faltan, valen estos valores.
GEMINI_EMBEDDING_MODELO=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768

# Cloudflare Workers AI por su API REST. Hacen falta las dos variables: si falta
# alguna, Cloudflare no se usa. El identificador de la cuenta y el token se obtienen
# en el panel de Cloudflare, en Workers AI, opción "Use REST API", con el plan gratuito.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Modelo de Cloudflare y cantidad de dimensiones de sus vectores.
# Si faltan, valen estos valores.
CLOUDFLARE_EMBEDDING_MODELO=@cf/baai/bge-m3
CLOUDFLARE_EMBEDDING_DIMENSION=1024

# Tiempo máximo de cada llamada para vectorizar una consulta, en segundos (mayor que 0).
# Es corto porque forma parte de la respuesta del chat. Si faltan, valen 2.
GEMINI_EMBEDDING_TIMEOUT_SEGUNDOS=2
CLOUDFLARE_EMBEDDING_TIMEOUT_SEGUNDOS=2

# Tiempo máximo de cada llamada para vectorizar un lote de documentos, en segundos
# (mayor que 0). Se usa al indexar. Si falta, vale 10.
EMBEDDING_TIMEOUT_DOCUMENTOS_SEGUNDOS=10

# Reintentos por proveedor ante una falla temporal (tiempo agotado, conexión, 5xx),
# entre 0 y 5. Un 429 o un error de configuración pasan al respaldo sin reintentar.
# Si falta, vale 1.
EMBEDDING_REINTENTOS=1

# Espera entre reintentos, en segundos: arranca en la base, se duplica en cada
# reintento y no supera el máximo. El máximo no puede ser menor que la base.
# Si faltan, valen 0.25 y 1.
EMBEDDING_BACKOFF_BASE_SEGUNDOS=0.25
EMBEDDING_BACKOFF_MAXIMO_SEGUNDOS=1

# Presupuesto total para vectorizar una consulta, en segundos, sumando reintentos y
# respaldo. Se reparte en partes iguales entre los proveedores. Si falta, vale 4.
EMBEDDING_PRESUPUESTO_SEGUNDOS=4

# --- Límite de solicitudes por sesión (RNF11) ---
# Cantidad máxima de solicitudes de una sesión dentro de la ventana, y duración de la
# ventana en segundos (ambos mayores que 0). Al superarla, la API responde 429.
# Si faltan, valen 10 y 60.
LIMITE_SOLICITUDES_MAXIMO=10
LIMITE_SOLICITUDES_VENTANA_SEGUNDOS=60

# --- API de administración (RNF11) ---
# Token que exigen las rutas de administración, en el encabezado
# "Authorization: Bearer <token>". Debe ser un valor aleatorio de 16 caracteres o más.
# Vacío o más corto: se rechazan todas las solicitudes de administración.
# En Vercel debe coincidir con CRON_SECRET para que la tarea programada pueda entrar.
ADMIN_API_TOKEN=

# --- Base de datos ---
# URL del proyecto de Supabase (https://<id>.supabase.co, sin /rest/v1) y su clave
# de API. Las dos se obtienen en el panel de Supabase, en "Project Settings / API Keys".
# Si falta alguna de las dos, la aplicación arranca sin base.
SUPABASE_URL=
SUPABASE_KEY=
