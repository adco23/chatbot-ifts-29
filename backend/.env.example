# Copiar a .env para desarrollo local. El archivo .env nunca se versiona.
# En Vercel estas variables se cargan desde la configuración del proyecto.

# Entorno de ejecución: local o produccion.
# En produccion no se lee ningún archivo .env.
ENTORNO=local

# Versión de la aplicación que informa GET /health.
VERSION_APP=0.1.0

# --- Modelos de lenguaje ---
# Ninguna de estas variables es obligatoria: la aplicación arranca sin ellas.
# Un proveedor sin clave queda fuera de la lista de proveedores disponibles.

# Clave de la API de Gemini (proveedor principal). Se genera en Google AI Studio,
# con una cuenta de Google y sin tarjeta. Vacía: Gemini no se usa.
GEMINI_API_KEY=

# Clave de la API de Groq (proveedor de respaldo). Se genera en la consola de
# GroqCloud, en la sección de claves de API, con el plan gratuito. Vacía: Groq no se usa.
GROQ_API_KEY=

# Modelo de cada proveedor. Debe estar disponible en su plan gratuito (RNF10).
# Si faltan, se usan estos mismos valores por defecto.
GEMINI_MODELO=gemini-3.8-flash
GROQ_MODELO=openai/gpt-oss-120b

# Tiempo máximo de espera de cada proveedor, en segundos (mayor que 0).
# Si faltan, se usan estos mismos valores por defecto.
GEMINI_TIMEOUT_SEGUNDOS=6
GROQ_TIMEOUT_SEGUNDOS=3

# Nivel de razonamiento de cada modelo: menos razonamiento, menos latencia.
# Gemini (thinkingLevel): MINIMAL, LOW, MEDIUM o HIGH; Gemini 3.8 Flash no admite
# MINIMAL. Groq (reasoning_effort, sólo modelos GPT-OSS): low, medium o high.
# Vacío: no se envía el parámetro (para modelos sin razonamiento).
# Si faltan, se usan estos mismos valores por defecto.
GEMINI_NIVEL_RAZONAMIENTO=LOW
GROQ_ESFUERZO_RAZONAMIENTO=low

# Presupuesto total de una generación, en segundos, sumando todos los intentos.
# Cuando se agota, no se prueba con más proveedores. No puede ser menor que el
# mayor de los tiempos máximos por proveedor. Si falta, vale 9.
LLM_PRESUPUESTO_SEGUNDOS=9

# Orden de prioridad de los proveedores, separados por comas.
# Nombres válidos: gemini, groq. Un nombre desconocido impide arrancar.
# Si falta, vale gemini,groq.
LLM_ORDEN_PROVEEDORES=gemini,groq

# Reintentos del proveedor principal ante una falla temporal: 0 o 1. Solo se
# reintenta el principal; una falla de cuota o permanente pasa al respaldo.
# Si falta, vale 1.
LLM_REINTENTOS_PRINCIPAL=1

# Espera base entre reintentos, en segundos (entre 0 y 5). Crece de forma exponencial
# con una variación de ±20 %, y el gestor limita cada espera a 2 s. Si falta, vale 1.
LLM_BACKOFF_SEGUNDOS=1

# --- Embeddings ---
# Ninguna de estas variables es obligatoria: la aplicación arranca sin ellas.
# El RAG usa un único índice (fragmento.vector), hecho con Gemini, gemini-embedding-001
# y 768 dimensiones. Los vectores de Cloudflare no sirven para buscar en ese índice.

# Proveedor de embeddings que se intenta primero: gemini o cloudflare. El otro queda
# de respaldo. Un nombre desconocido impide arrancar. Si falta, vale gemini.
# El RAG exige gemini: con cloudflare la aplicación arranca, pero las consultas,
# la caché de FAQ y la sincronización fallan.
EMBEDDING_PRIMARY=gemini

# Gemini usa para los embeddings la misma clave que para el modelo de lenguaje
# (GEMINI_API_KEY, más arriba). Sin esa clave, Gemini tampoco genera embeddings.
# Modelo y cantidad de dimensiones de sus vectores. Si faltan, valen estos valores.
# El RAG exige exactamente estos valores: con otros, el RAG falla igual que arriba.
GEMINI_EMBEDDING_MODELO=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768

# Cloudflare Workers AI por su API REST. Es un respaldo de contingencia: sus
# vectores no son compatibles con el índice del RAG. Hacen falta las dos variables:
# si falta alguna, Cloudflare no se usa. El identificador de la cuenta y el token se
# obtienen en el panel de Cloudflare, en Workers AI, opción "Use REST API", con el
# plan gratuito.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Modelo de Cloudflare y cantidad de dimensiones de sus vectores.
# Si faltan, valen estos valores.
CLOUDFLARE_EMBEDDING_MODELO=@cf/baai/bge-m3
CLOUDFLARE_EMBEDDING_DIMENSION=1024

# Tiempo máximo de cada llamada para vectorizar una consulta, en segundos (mayor que 0).
# Es corto porque forma parte de la respuesta del chat. Si faltan, valen 2.
GEMINI_EMBEDDING_TIMEOUT_SEGUNDOS=2
CLOUDFLARE_EMBEDDING_TIMEOUT_SEGUNDOS=2

# Tiempo máximo de cada llamada para vectorizar un lote de documentos, en segundos
# (mayor que 0). Se usa al indexar. Si falta, vale 10.
EMBEDDING_TIMEOUT_DOCUMENTOS_SEGUNDOS=10

# Reintentos por proveedor ante una falla temporal (tiempo agotado, conexión, 5xx),
# entre 0 y 5. Un 429 o un error de configuración pasan al respaldo sin reintentar.
# Si falta, vale 1.
EMBEDDING_REINTENTOS=1

# Espera entre reintentos, en segundos: arranca en la base, se duplica en cada
# reintento y no supera el máximo. El máximo no puede ser menor que la base.
# Si faltan, valen 0.25 y 1.
EMBEDDING_BACKOFF_BASE_SEGUNDOS=0.25
EMBEDDING_BACKOFF_MAXIMO_SEGUNDOS=1

# Presupuesto total para vectorizar una consulta, en segundos, sumando reintentos y
# respaldo. Se reparte en partes iguales entre los proveedores. Si falta, vale 4.
EMBEDDING_PRESUPUESTO_SEGUNDOS=4

# --- Recuperación (RAG) ---
# Cantidad de fragmentos que se recuperan por consulta: entero mayor que 0.
# Si falta, vale 5.
RAG_TOP_K=5

# Umbral de confianza general, entre 0 y 1. Se calcula a partir del mejor coseno
# y es una heurística, no una probabilidad. Si falta, vale 0.70.
RAG_UMBRAL_CONFIANZA=0.70

# Umbrales opcionales para consultas sobre cronogramas y programas, entre 0 y 1.
# Si faltan, se usa RAG_UMBRAL_CONFIANZA. No hay que dejarlas vacías: un valor vacío
# impide arrancar. Para usarlas, quitar el # y poner un número.
# RAG_UMBRAL_CRONOGRAMA=0.70
# RAG_UMBRAL_PROGRAMA=0.70

# Términos que clasifican una consulta como de cronograma, de programa o general,
# separados por comas. Si faltan, se usan las listas definidas en app/settings.py.
# Al definir una, reemplaza la lista completa: hay que incluir todos sus términos.
# RAG_TERMINOS_CRONOGRAMA=horario,horarios,cronograma,clase,clases,parcial,parciales,examen,examenes,fecha de parcial,fechas de cursada,recuperatorio,recuperatorios,pfo
# RAG_TERMINOS_PROGRAMA=contenido,contenidos,programa,objetivos,unidades,temas,bibliografia
# RAG_TERMINOS_GENERAL=inscripcion,inscripciones,ingresantes,documentacion para ingresar,siu,moodle,informacion institucional

# --- Metadatos de los documentos de Drive ---
# Largo máximo del código de comisión en el nombre del archivo (COM-<código>),
# entre 1 y 32. Si falta, vale 8.
METADATA_COMISION_MAX_LONGITUD=8

# Tipos de documento admitidos como último componente del nombre del archivo,
# separados por comas. Si falta, vale Programa,Cronograma.
METADATA_TIPOS_DOCUMENTALES=Programa,Cronograma

# --- Límite de solicitudes por sesión (RNF11) ---
# Cantidad máxima de solicitudes de una sesión dentro de la ventana, y duración de la
# ventana en segundos (ambos mayores que 0). Al superarla, la API responde 429.
# Si faltan, valen 10 y 60.
LIMITE_SOLICITUDES_MAXIMO=10
LIMITE_SOLICITUDES_VENTANA_SEGUNDOS=60

# --- CORS ---
# Orígenes desde los que el navegador puede llamar a la API, separados por comas.
# Van exactos, con esquema y sin barra final (https://<widget>.vercel.app). '*' se
# rechaza. Vacía: no se permite ningún origen cruzado. Si falta, vale
# http://localhost:5173. En Vercel hay que cargar la URL real del widget.
CORS_ORIGENES=http://localhost:5173

# --- API de administración (RNF11) ---
# Token que exigen las rutas de administración, en el encabezado
# "Authorization: Bearer <token>". Debe ser un valor aleatorio de 16 caracteres o más.
# Vacío o más corto: se rechazan todas las solicitudes de administración.
# En Vercel debe coincidir con CRON_SECRET para que la tarea programada pueda entrar.
ADMIN_API_TOKEN=

# --- Base de datos ---
# URL del proyecto de Supabase (https://<id>.supabase.co, sin /rest/v1) y su clave
# de API. Las dos se obtienen en el panel de Supabase, en "Project Settings / API Keys".
# Si falta alguna de las dos, la aplicación arranca sin base.
SUPABASE_URL=
SUPABASE_KEY=
# Opcional antes de 0008; obligatorio para operaciones protegidas después de 0008.
# Solo backend: sb_secret_... o JWT service_role. Nunca usar en React/VITE_*.
SUPABASE_BACKEND_KEY=
# Timeout de transporte; cancelar un await no interrumpe un hilo HTTP en curso.
SUPABASE_TIMEOUT_SEGUNDOS=5

# --- Google Drive ---
# Contenido completo del JSON de la cuenta de servicio, en una sola línea. Es
# secreto: nunca registrarlo. Vacía: se usa el archivo credentials.json del
# directorio de trabajo, si existe. Sin ninguno de los dos, Drive no se usa.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Identificador de la carpeta de Drive que se indexa. El código la lee del entorno
# del proceso y no de este archivo: en local hay que definirla en la terminal, y en
# Vercel, en la configuración del proyecto. Si falta, se usa la carpeta fija de
# app/drive/cliente.py.
# GOOGLE_DRIVE_FOLDER_ID=

# Caché FAQ: independiente del umbral general RAG (0.70).
UMBRAL_CACHE_FAQ=0.75
# Fase posterior al sync documental: puede quedar pendiente si agota este presupuesto.
FAQ_REGENERACION_MAXIMO=2
FAQ_REGENERACION_PRESUPUESTO_SEGUNDOS=5

# --- Depuración ---
# DEBUG_LLM=1 imprime las llamadas a los modelos de lenguaje, sin las claves. Igual
# que GOOGLE_DRIVE_FOLDER_ID, se lee del entorno del proceso y no de este archivo.
# Nunca se activa con ENTORNO=produccion, porque lo impreso incluye la consulta del
# estudiante (RNF01).
# DEBUG_LLM=1
