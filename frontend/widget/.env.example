# URL base del backend (sin barra final), por ejemplo https://backend-xxxx.vercel.app
# Vacía = el widget usa el cliente mock con respuestas simuladas.
VITE_API_URL=

# Orígenes del padre a los que el widget puede avisar cambios de tamaño (postMessage),
# separados por coma. Incluir el campus y moodle-sim.
VITE_ORIGENES_PADRE=http://localhost:5174

# RF14: preguntas sugeridas (complementario). true para activarlas.
VITE_PREGUNTAS_SUGERIDAS=false
